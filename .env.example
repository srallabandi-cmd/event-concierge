# Cursor SDK — get from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# OpenAI for structured event evaluation (optional; falls back to heuristics)
OPENAI_API_KEY=sk-...

# Gmail OAuth — download from Google Cloud Console
GMAIL_CREDENTIALS_PATH=~/.config/event-concierge/gmail_credentials.json
GMAIL_TOKEN_PATH=~/.config/event-concierge/gmail_token.json

# LinkedIn session — Playwright persists login in this directory
LINKEDIN_PROFILE_DIR=~/.config/event-concierge/linkedin_profile

# Notification channel — where secretary briefings are sent
NOTIFY_EMAIL=you@gmail.com
NOTIFY_PHONE=+14155551234

# User identity for form fills
USER_FULL_NAME=Siddharth Rallabandi
USER_EMAIL=you@gmail.com
USER_LINKEDIN_URL=https://linkedin.com/in/yourprofile
USER_TITLE=AI Product Manager
USER_COMPANY=Your Company
USER_LOCATION=San Francisco, CA
